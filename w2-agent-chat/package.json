{
  "name": "w2-agent-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "W2 练手：Vercel AI SDK 流式聊天 + 工具调用（Express + Vite + React）",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "memory:start": "AGENTMEMORY_DATA_DIR=$PWD/.agentmemory npx -y @agentmemory/agentmemory",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "test": "node --import tsx --test tests/eval.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/react": "^4.0.61",
    "ai": "^7.0.58",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
