# 复制为 .env 并填入真实值
# 兼容 OpenAI 官方 / DeepSeek / 通义 / OpenRouter 等任意 OpenAI 协议服务商

OPENAI_API_KEY=sk-xxxx
# 留空则用 OpenAI 官方；DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Embedding 模型（DeepSeek 不提供，默认 OpenAI text-embedding-3-small）
AI_EMBEDDING_MODEL=text-embedding-3-small

PORT=3002
