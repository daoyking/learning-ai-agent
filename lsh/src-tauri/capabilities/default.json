{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LSH 基础能力：执行本机运维命令、扫描端口、读写 manifest。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "shell:allow-open"
  ]
}
